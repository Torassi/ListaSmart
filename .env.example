# =====================================================================
# Variáveis de ambiente — Lista Smart (front-end)
# Copie este arquivo para `.env` e preencha. O `.env` NÃO é versionado.
#
# SECURITY:
# - Apenas variáveis com prefixo VITE_ são expostas ao bundle do cliente.
#   NUNCA coloque segredos/chaves privadas aqui — tudo que tem VITE_ vai
#   parar no JavaScript público entregue ao navegador.
# - Segredos reais (client secrets de OAuth, chaves de API privadas) devem
#   viver somente no back-end.
# =====================================================================

# URL base da API (quando o back-end existir). Use sempre HTTPS em produção.
VITE_API_BASE_URL=https://api.exemplo.com

# IDs públicos de login social (não são segredos — o client secret fica no back-end).
VITE_GOOGLE_CLIENT_ID=
VITE_FACEBOOK_APP_ID=
