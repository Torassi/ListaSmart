# ---------------------------------------------------------------------------
# Lista Smart — backend environment (copie para `.env` e ajuste)
# ---------------------------------------------------------------------------

# Banco de dados (SQLite para desenvolvimento local). Não precisa instalar o
# SQLite: o Python já o traz pelo módulo `sqlite3`.
DATABASE_URL=sqlite:///./listasmart.db

# Segredo usado para assinar o JWT da sessão.
# OBRIGATÓRIO: este é um PLACEHOLDER e o backend RECUSA INICIAR enquanto ele não
# for substituído (valores de exemplo, vazios ou muito curtos são rejeitados).
# Gere um valor forte e SUBSTITUA manualmente o valor abaixo:
#   .\.venv\Scripts\python.exe -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=troque-este-segredo-em-producao

# Validade do token de sessão (em minutos). Padrão: 7 dias.
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Origens permitidas pelo CORS (front-end). Separe por vírgula.
# Vite roda em http://localhost:5173. Para acesso direto à API pelo navegador do
# celular (diagnóstico), inclua também o IP da máquina na LAN, ex.:
#   CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://SEU_IP:5173
# No app, o front usa /api na MESMA origem (proxy do Vite) — sem CORS no navegador.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Configuração do cookie de sessão.
# Em produção (HTTPS) use COOKIE_SECURE=true e, se front e API estiverem em
# domínios diferentes, COOKIE_SAMESITE=none (exige Secure=true).
COOKIE_NAME=listasmart_session
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
