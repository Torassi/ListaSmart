# ---------------------------------------------------------------------------
# Lista Smart — backend environment (copie para `.env` e ajuste)
# ---------------------------------------------------------------------------

# Banco de dados (SQLite para desenvolvimento local).
DATABASE_URL=sqlite:///./listasmart.db

# Segredo usado para assinar o JWT da sessão. GERE UM VALOR FORTE em produção:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=troque-este-segredo-em-producao

# Validade do token de sessão (em minutos). Padrão: 7 dias.
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Origens permitidas pelo CORS (front-end). Separe por vírgula.
# Vite roda por padrão em http://localhost:5173.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Configuração do cookie de sessão.
# Em produção (HTTPS) use COOKIE_SECURE=true e, se front e API estiverem em
# domínios diferentes, COOKIE_SAMESITE=none (exige Secure=true).
COOKIE_NAME=listasmart_session
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
